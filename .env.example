# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Link hospedado do Stripe. Hoje serve de rede de segurança: se a sessão do checkout
# embutido não abrir, o botão cai para cá em vez de perder a venda.
VITE_CHECKOUT_URL="https://buy.stripe.com/8x2fZiesE5Zteuy9tpgA800"

# ── Checkout embutido ────────────────────────────────────────────────────────────
# Chave PUBLICÁVEL (pk_live_...). Vai para o navegador de propósito — é pública.
VITE_STRIPE_PUBLISHABLE_KEY=""

# Chave RESTRITA (rk_live_...), com permissão apenas de "Checkout Sessions: write".
# Sem prefixo VITE_ de propósito: o Vite só injeta no bundle o que tem esse prefixo,
# então ela é estruturalmente incapaz de descer para o navegador. Só no Netlify.
STRIPE_SECRET_KEY=""

# O Price ID do produto (Stripe > Produtos). O preço mora aqui, nunca no navegador.
STRIPE_PRICE_ID=""

# Quem paga os 3,5% de IOF do Pix. A conta é dos EUA, então toda compra por Pix de um
# brasileiro é internacional e a taxa incide.
#   vazio/false → o comprador paga: anuncia R$ 39,90, o banco pede R$ 41,30
#   true        → nós absorvemos: o banco pede exatamente o preço anunciado
PIX_ABSORVER_IOF=""

# Link do vídeo da VSL no YouTube (ex: https://www.youtube.com/watch?v=SEU_CODIGO_AQUI)
VITE_YOUTUBE_URL=""

# Configurações para deploy no Netlify (evitar falso-positivo de bloqueio de chaves públicas AIza do Firebase)
SECRETS_SCAN_OMIT_KEYS="VITE_FIREBASE_API_KEY"
SECRETS_SCAN_SMART_DETECTION_ENABLED="false"
